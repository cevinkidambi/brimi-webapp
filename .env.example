# BRIMI Web App — Environment Variables
# Copy to investdata_api/.env for local runs (never commit real .env).
# On Vercel, set these as project env vars for BOTH Production and Preview.
# Host-agnostic: any hosting platform can supply these as env vars.

# ── Investdata API credentials ────────────────────────────────────────────────
# WARNING: current creds belong to a departing employee account and WILL be
# replaced. Request fresh values from Infovesta for the team account.
INVESTDATA_USERNAME=YOUR_INVESTDATA_USERNAME
INVESTDATA_PASSWORD=YOUR_INVESTDATA_PASSWORD
INVESTDATA_CLIENT_ID=api2
INVESTDATA_CLIENT_SECRET=api2

# ── GitHub API (used by /admin save to commit peer_overrides.json) ──────────
# Personal access token with `repo` scope. Set on the host, not required locally.
# UPDATE THESE on handover: repo moves to the team org, and the PAT must be
# re-issued on an account the team controls.
GITHUB_TOKEN=YOUR_GITHUB_PAT
GITHUB_REPO_OWNER=cevinkidambi
GITHUB_REPO_NAME=brimi-webapp
GITHUB_BRANCH=main